# ---------------------------------------------------------------------
# App Mundo da Prô — variáveis de ambiente
# Copie para .env.local (web) e .env (app). Nunca commite os arquivos preenchidos.
# ---------------------------------------------------------------------

# ---- COMPARTILHADO ----
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- SÓ NO SERVIDOR (apps/web) ----
# Jamais prefixe com NEXT_PUBLIC_ e jamais coloque no app Expo:
# o binário do app é inspecionável por qualquer pessoa.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=              # sugestão de taxonomia e Como usar no painel
THEMEMBERS_WEBHOOK_SECRET=      # assinatura para validar a origem do webhook
THEMEMBERS_API_TOKEN=           # só no script de ingestão
THEMEMBERS_API_BASE=
PANDA_API_KEY=                  # listagem de vídeos e embeds das aulas (D31)
CRON_SECRET=                    # publicação agendada na Vercel
EXPO_ACCESS_TOKEN=              # envio de push pelo serviço da Expo

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- APP EXPO (apps/app) ----
# Só variáveis públicas. Prefixo EXPO_PUBLIC_ vai para o binário.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000     # onde ficam as rotas /api
EXPO_PUBLIC_SUPORTE_WHATSAPP=                 # link do WhatsApp da Mari

# ---- EAS / LOJAS ----
EAS_PROJECT_ID=
APPLE_TEAM_ID=
APPLE_APP_ID=                   # identificador numérico na App Store Connect
ANDROID_PACKAGE=                # ex: br.com.mundodapro.app
GOOGLE_SERVICE_ACCOUNT_JSON=    # caminho do arquivo, para o eas submit
THEACCESS_PRIVATE_KEY_PATH=segredos/theaccess-privada.pem   # assina o login sem senha no The Members (D35)
THEMEMBERS_ORGANIZATION_ID=
